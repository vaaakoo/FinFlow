{
  "ReverseProxy": {
    "Routes": {
      "accounts": {
        "ClusterId": "ledger",
        "AuthorizationPolicy": "BankStaff",
        "RateLimiterPolicy": "ApiRequests",
        "Match": { "Path": "/accounts", "Methods": ["GET"] }
      },
      "transfers": {
        "ClusterId": "ledger",
        "AuthorizationPolicy": "BankStaff",
        "RateLimiterPolicy": "ApiRequests",
        "Match": { "Path": "/transfers", "Methods": ["POST"] }
      },
      "statement": {
        "ClusterId": "ledger",
        "AuthorizationPolicy": "BankStaff",
        "RateLimiterPolicy": "ApiRequests",
        "Match": { "Path": "/accounts/{accountId:guid}/statement", "Methods": ["GET"] }
      },
      "reconciliation": {
        "ClusterId": "ledger",
        "AuthorizationPolicy": "BankStaff",
        "RateLimiterPolicy": "ApiRequests",
        "Match": { "Path": "/staff/ledger/reconciliation", "Methods": ["GET"] }
      },
      "transfer": {
        "ClusterId": "ledger",
        "AuthorizationPolicy": "BankStaff",
        "RateLimiterPolicy": "ApiRequests",
        "Match": { "Path": "/transfers/{id:guid}", "Methods": ["GET"] }
      },
      "customer-profile": {
        "ClusterId": "customers",
        "AuthorizationPolicy": "Customer",
        "RateLimiterPolicy": "ApiRequests",
        "Match": { "Path": "/customers/me", "Methods": ["GET", "POST", "PUT"] }
      },
      "owned-accounts": {
        "ClusterId": "ledger",
        "AuthorizationPolicy": "Customer",
        "RateLimiterPolicy": "ApiRequests",
        "Match": { "Path": "/customers/me/accounts", "Methods": ["GET"] }
      },
      "owned-statement": {
        "ClusterId": "ledger",
        "AuthorizationPolicy": "Customer",
        "RateLimiterPolicy": "ApiRequests",
        "Match": { "Path": "/customers/me/accounts/{accountId:guid}/statement", "Methods": ["GET"] }
      },
      "customer-transfers": {
        "ClusterId": "transfers",
        "AuthorizationPolicy": "Customer",
        "RateLimiterPolicy": "ApiRequests",
        "Match": { "Path": "/customers/me/transfers/{**path}", "Methods": ["GET", "POST"] }
      },
      "open-account": {
        "ClusterId": "ledger",
        "AuthorizationPolicy": "BankStaff",
        "RateLimiterPolicy": "ApiRequests",
        "Match": { "Path": "/staff/ledger/accounts", "Methods": ["POST"] }
      },
      "staff-customer-management": {
        "ClusterId": "customers",
        "AuthorizationPolicy": "BankStaff",
        "RateLimiterPolicy": "ApiRequests",
        "Match": { "Path": "/staff/customers/{**path}", "Methods": ["GET", "PUT"] }
      }
    },
    "Clusters": {
      "ledger": {
        "Destinations": { "primary": { "Address": "http://ledger:8080/" } }
      },
      "customers": {
        "Destinations": { "primary": { "Address": "http://customers:8080/" } }
      },
      "transfers": {
        "Destinations": { "primary": { "Address": "http://transfers:8080/" } }
      }
    }
  }
}
